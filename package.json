{
  "name": "catchgrid-pokemon-go-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual, Cloudflare-native Pokemon GO collection companion.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run cf-typegen && tsc -b && vite build",
    "build:artifact": "tsc -b && vite build && pnpm run bundle:report",
    "bundle:report": "node scripts/report-bundle.mjs",
    "preview": "vite preview",
    "deploy:production": "pnpm run release:preflight && pnpm run release:bookmark:production && pnpm run release:migrate:production && pnpm run release:deploy:production && pnpm run release:smoke:production",
    "cf-typegen": "wrangler types node_modules/.worker-configuration.d.ts",
    "cf-typegen:check": "wrangler types node_modules/.worker-configuration.d.ts --check",
    "db:migrate:local": "wrangler d1 migrations apply dexly-db --local",
    "db:migrate:production": "wrangler d1 migrations apply dexly-db --remote",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:worker:watch": "vitest --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=mobile-chromium --project=desktop-chromium",
    "test:e2e:webkit": "playwright test --project=mobile-webkit --project=desktop-webkit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:sync:evolutions": "node scripts/sync-evolution-families.mjs",
    "catalog:verify": "node scripts/verify-sprites.mjs && node scripts/verify-catalog-generation.mjs",
    "validate:pokemon-data": "node scripts/validate-pokemon-data.mjs",
    "validate:source": "pnpm run cf-typegen && pnpm run cf-typegen:check && pnpm run lint && pnpm run format && pnpm run test && pnpm run validate:pokemon-data && pnpm run catalog:verify",
    "check": "pnpm run validate:source && pnpm run build:artifact",
    "release:preflight": "pnpm run validate:source && pnpm run build:artifact && pnpm run test:e2e && wrangler deploy --dry-run --strict",
    "release:bookmark:production": "wrangler d1 time-travel info dexly-db --json",
    "release:migrate:production": "wrangler d1 migrations apply dexly-db --remote",
    "release:deploy:production": "wrangler deploy --strict --message CatchGrid-production-release",
    "release:smoke:production": "node scripts/smoke-production.mjs https://dex.cjdev.app",
    "release:rollback:production": "wrangler rollback --message CatchGrid-operator-rollback"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.51.2",
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0"
}
