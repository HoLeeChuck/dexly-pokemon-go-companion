{
  "name": "dexly-pokemon-go-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A visual, Cloudflare-native Pokemon GO collection companion.",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run cf-typegen && tsc -b && vite build",
    "preview": "vite preview",
    "deploy:production": "pnpm run build && pnpm run db:migrate:production && wrangler deploy",
    "cf-typegen": "wrangler types node_modules/.worker-configuration.d.ts",
    "cf-typegen:check": "wrangler types node_modules/.worker-configuration.d.ts --check",
    "db:migrate:local": "wrangler d1 migrations apply dexly-db --local",
    "db:migrate:production": "wrangler d1 migrations apply dexly-db --remote",
    "test": "pnpm run test:unit && pnpm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:worker:watch": "vitest --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:verify": "node scripts/verify-sprites.mjs",
    "check": "pnpm lint && pnpm format && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.2",
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.21.0"
}
